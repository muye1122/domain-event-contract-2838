{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/events/contract.signed.schema.json",
  "title": "Contract Signed Event",
  "description": "Emitted when a rider service contract is signed. All identifiers are synthetic.",
  "type": "object",
  "required": ["event_id", "event_type", "version", "occurred_at", "org_id", "site_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt_[a-f0-9]{12,}$", "description": "Globally unique event identifier." },
    "event_type": { "type": "string", "const": "contract.signed" },
    "version": { "type": "string", "enum": ["v1"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "org_id": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["contract_id", "rider_id", "signed_at", "channel", "amount", "currency"],
      "properties": {
        "contract_id": { "type": "string", "minLength": 1 },
        "rider_id": { "type": "string", "minLength": 1 },
        "signed_at": { "type": "string", "format": "date-time" },
        "channel": { "type": "string", "enum": ["online", "station", "agent"] },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "enum": ["CNY", "USD"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
