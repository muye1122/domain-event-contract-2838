{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/events/certification.approved.schema.json",
  "title": "Certification Approved Event",
  "description": "Emitted when a subject certification is reviewed and approved.",
  "type": "object",
  "required": ["event_id", "event_type", "version", "occurred_at", "org_id", "site_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt_[a-f0-9]{12,}$", "description": "Globally unique event identifier." },
    "event_type": { "type": "string", "const": "certification.approved" },
    "version": { "type": "string", "enum": ["v1"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "org_id": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["certification_id", "subject_id", "cert_type", "approved_by", "approved_at", "expires_at"],
      "properties": {
        "certification_id": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 },
        "cert_type": { "type": "string", "enum": ["rider_safety", "station_ops", "service_quality"] },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
