{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/events/quote.approved.schema.json",
  "title": "Quote Approved Event",
  "description": "Emitted when a service quote is approved and becomes billable.",
  "type": "object",
  "required": ["event_id", "event_type", "version", "occurred_at", "org_id", "site_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt_[a-f0-9]{12,}$", "description": "Globally unique event identifier." },
    "event_type": { "type": "string", "const": "quote.approved" },
    "version": { "type": "string", "enum": ["v1"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "org_id": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["quote_id", "contract_id", "amount", "currency", "approved_by", "approved_at"],
      "properties": {
        "quote_id": { "type": "string", "minLength": 1 },
        "contract_id": { "type": "string", "minLength": 1 },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "enum": ["CNY", "USD"] },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
